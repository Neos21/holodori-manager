{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holodori-manager",
  "compatibility_date": "2026-08-11",
  "account_id": "07100c21a5c21a0afb93ab435ba46712",
  "main": "./server/index.ts",
  "assets": {
    "directory": "./build/client",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "holodori-manager",
      "database_id": "a0689055-cdc6-439b-9e84-8c6a34f3d16c"
    }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "placement": {
    "mode": "smart"
  }
}
